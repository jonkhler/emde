---
source: crates/emde-math/tests/corpus.rs
expression: "render_all(formulas, & MathOptions :: default(), WIDTH)"
---
── f(x) = \begin{cases} 1 & x > 0 \\ 0 & \text{otherwise} \end{cases}
inline  f(x) = {1, x > 0; 0, otherwise}
  │       ⎧ 1  x > 0    │
▸ │f(x) = ⎨             │
  │       ⎩ 0  otherwise│

── |x| = \begin{cases} x & x \ge 0 \\ -x & x < 0 \end{cases}
inline  |x| = {x, x ≥ 0; −x, x < 0}
  │      ⎧ x   x ≥ 0│
▸ │|x| = ⎨          │
  │      ⎩ −x  x < 0│

── \operatorname{sgn}(x) = \begin{cases} 1 & x > 0 \\ 0 & x = 0 \\ -1 & x < 0 \end{cases}
inline  sgn(x) = {1, x > 0; 0, x = 0; −1, x < 0}
  │         ⎧ 1   x > 0│
  │         ⎪          │
▸ │sgn(x) = ⎨ 0   x = 0│
  │         ⎪          │
  │         ⎩ −1  x < 0│

── \begin{aligned} f(x) &= (x+1)^2 \\ &= x^2 + 2x + 1 \end{aligned}
inline  f(x) = (x + 1)² = x² + 2x + 1
▸ │f(x) = (x + 1)²   │
  │     = x² + 2x + 1│

── \begin{align*} a &= b \\ c &= d \end{align*}
inline  a = b; c = d
▸ │a = b│
  │c = d│

── \begin{gathered} a = b \\ c = d \end{gathered}
inline  a = b; c = d
▸ │a = b│
  │c = d│

── a = b \\ c = d
inline  a = b; c = d
▸ │a = b│
  │c = d│

── x &= 1 \\ y &= 2
inline  x = 1; y = 2
▸ │x = 1│
  │y = 2│

── \begin{equation} E = mc^2 \end{equation}
inline  E = mc²
▸ │E = mc²│

── \begin{split} a &= b + c \\ &= d \end{split}
inline  a = b + c = d
▸ │a = b + c│
  │  = d    │

── \begin{aligned} x &= 1 & y &= 2 \end{aligned}
inline  x = 1  y = 2
▸ │x = 1  y = 2│

── \begin{aligned} a + b &= c \\ &\quad + d \end{aligned}
inline  a + b = c + d
▸ │a + b = c  │
  │        + d│

── a = b \\ c = d % trailing comment
inline  a = b; c = d
▸ │a = b│
  │c = d│

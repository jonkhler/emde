source: crates/emde-math/tests/corpus.rs
expression: "render_all(formulas, & MathOptions :: default(), WIDTH)"
---
── \begin{pmatrix} a & b \\ c & d \end{pmatrix}
inline  (a b; c d)
▸ │⎛a  b⎞│
  │⎝c  d⎠│

── \begin{bmatrix} 1 & 0 \\ 0 & 1 \end{bmatrix}
inline  [1 0; 0 1]
▸ │⎡1  0⎤│
  │⎣0  1⎦│

── \begin{Bmatrix} x \\ y \end{Bmatrix}
inline  {x; y}
▸ │⎰x⎱│
  │⎱y⎰│

── \begin{vmatrix} a & b \\ c & d \end{vmatrix} = ad - bc
inline  |a b; c d| = ad − bc
▸ ││a  b│ = ad − bc│
  ││c  d│          │

── \begin{Vmatrix} x \end{Vmatrix}
inline  ‖x‖
▸ │‖x‖│

── \begin{matrix} a & b \\ c & d \end{matrix}
inline  a b; c d
▸ │a  b│
  │c  d│

── \begin{pmatrix} 1 & 2 & 3 \\ 4 & 5 & 6 \\ 7 & 8 & 9 \end{pmatrix}
inline  (1 2 3; 4 5 6; 7 8 9)
  │⎛1  2  3⎞│
▸ │⎜4  5  6⎟│
  │⎝7  8  9⎠│

── \begin{pmatrix} \frac{1}{2} & 0 \\ 0 & \frac{1}{3} \end{pmatrix}
inline  (½ 0; 0 ⅓)
  │⎛1   ⎞│
  │⎜─  0⎟│
  │⎜2   ⎟│
▸ │⎜    ⎟│
  │⎜   1⎟│
  │⎜0  ─⎟│
  │⎝   3⎠│

── \begin{smallmatrix} a & b \\ c & d \end{smallmatrix}
inline  a b; c d
▸ │a  b│
  │c  d│

── A = \begin{pmatrix} a & b \\ c & d \end{pmatrix}
inline  A = (a b; c d)
▸ │A = ⎛a  b⎞│
  │    ⎝c  d⎠│

── \begin{array}{c|c} a & b \\ \hline c & d \end{array}
inline  a b; c d
  │a │ b│
▸ │──┼──│
  │c │ d│

── \left[\begin{array}{cc|c} 1 & 2 & 3 \\ 4 & 5 & 6 \end{array}\right]
inline  [1 2 3; 4 5 6]
▸ │⎡1  2 │ 3⎤│
  │⎣4  5 │ 6⎦│

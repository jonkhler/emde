│ import math      │
│                  │
│ def solve(a, b,  │
│↳c):              │
│     d = b * b -  │
│↳4 * a * c        │
│     if d < 0:    │
│         return [ │
│↳]                │
│     return [(-b  │
│↳+ s * math.sqrt( │
│↳d)) / (2 * a) fo │
│↳r s in (1, -1)]  │
└──────────────────┘

╭─────────┬────────╮
│ Case    │ Roots  │
├─────────┼────────┤
│ \Delta  │ 2 real │

━━ width 120 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
          ⟦fg=#cba6f7 bold⟧Solving the quadratic equation⟦/⟧
          ⟦fg=#cba6f7 bold⟧━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━⟦/⟧⟦fg=#cba6f7⟧──⟦/⟧⟦fg=#c6a2f2⟧──⟦/⟧⟦fg=#c29fec⟧──⟦/⟧⟦fg=#bd9be7⟧──⟦/⟧⟦fg=#b897e1⟧──⟦/⟧⟦fg=#b494dc⟧──⟦/⟧⟦fg=#af90d7⟧──⟦/⟧⟦fg=#aa8dd1⟧──⟦/⟧⟦fg=#a689cc⟧──⟦/⟧⟦fg=#a185c7⟧──⟦/⟧⟦fg=#9d82c1⟧──⟦/⟧⟦fg=#987ebc⟧──⟦/⟧⟦fg=#947bb7⟧──⟦/⟧⟦fg=#8f77b2⟧──⟦/⟧⟦fg=#8b74ad⟧──⟦/⟧⟦fg=#8670a8⟧──⟦/⟧⟦fg=#826da3⟧──⟦/⟧⟦fg=#7e6a9d⟧──⟦/⟧⟦fg=#796698⟧──⟦/⟧⟦fg=#756393⟧──⟦/⟧⟦fg=#71608e⟧──⟦/⟧⟦fg=#6d5c8a⟧──⟦/⟧⟦fg=#685985⟧──⟦/⟧⟦fg=#645680⟧──⟦/⟧⟦fg=#60527b⟧──⟦/⟧⟦fg=#5c4f76⟧──⟦/⟧⟦fg=#584c71⟧──⟦/⟧⟦fg=#54496d⟧──⟦/⟧⟦fg=#504568⟧──⟦/⟧⟦fg=#4c4263⟧──⟦/⟧⟦fg=#483f5f⟧──⟦/⟧⟦fg=#443c5a⟧──⟦/⟧⟦fg=#403956⟧──⟦/⟧⟦fg=#3c3651⟧──⟦/⟧⟦fg=#38334d⟧──⟦/⟧

          To solve ⟦fg=#f38ba8 ul=curly ulc=#f38ba8⟧ax^2 + bx + c = 0⟦/⟧, use the ⟦bold⟧quadratic formula⟦/⟧:

                                         ⟦fg=#f38ba8 ul=curly ulc=#f38ba8⟧x = \frac{-b \pm \sqrt{b^2 - 4ac}}{2a}⟦/⟧

          ⟦fg=#94e2d5 bold⟧▎ Steps⟦/⟧

          ⟦fg=#89b4fa⟧1.⟦/⟧ ⟦bold⟧Compute the discriminant⟦/⟧ ⟦fg=#f38ba8 ul=curly ulc=#f38ba8⟧\Delta = b^2 - 4ac⟦/⟧.
          ⟦fg=#89b4fa⟧2.⟦/⟧ ⟦bold⟧Check its sign⟦/⟧:
             ⟦fg=#89b4fa⟧◦⟦/⟧ If ⟦fg=#f38ba8 ul=curly ulc=#f38ba8⟧\Delta > 0⟦/⟧: two real roots.
             ⟦fg=#89b4fa⟧◦⟦/⟧ If ⟦fg=#f38ba8 ul=curly ulc=#f38ba8⟧\Delta = 0⟦/⟧: one real root.
             ⟦fg=#89b4fa⟧◦⟦/⟧ If ⟦fg=#f38ba8 ul=curly ulc=#f38ba8⟧\Delta < 0⟦/⟧: two complex roots.
          ⟦fg=#89b4fa⟧3.⟦/⟧ ⟦bold⟧Apply the formula⟦/⟧ above.

          ⟦fg=#6c7086⟧▎⟦/⟧ ⟦fg=#a6adc8 bold⟧Note:⟦/⟧⟦fg=#a6adc8⟧ when ⟦/⟧⟦fg=#f38ba8 ul=curly ulc=#f38ba8⟧a = 0⟦/⟧⟦fg=#a6adc8⟧ the equation is linear, not quadratic.⟦/⟧

          ⟦fg=#94e2d5 bold⟧▎ Example in Python⟦/⟧

          ⟦bg=#2c2d3d⟧                                                                                             ⟦/⟧⟦fg=#6c7086 bg=#2c2d3d⟧python⟦/⟧⟦bg=#2c2d3d⟧ ⟦/⟧
          ⟦bg=#2c2d3d⟧ ⟦/⟧⟦fg=#cba6f7 bg=#2c2d3d bold⟧import⟦/⟧⟦bg=#2c2d3d⟧ math                                                                                        ⟦/⟧
          ⟦bg=#2c2d3d⟧                                                                                                    ⟦/⟧
          ⟦bg=#2c2d3d⟧ ⟦/⟧⟦fg=#cba6f7 bg=#2c2d3d bold⟧def⟦/⟧⟦bg=#2c2d3d⟧ solve(a, b, c):                                                                                ⟦/⟧
          ⟦bg=#2c2d3d⟧     d = b * b - ⟦/⟧⟦fg=#fab387 bg=#2c2d3d⟧4⟦/⟧⟦bg=#2c2d3d⟧ * a * c                                                                          ⟦/⟧
          ⟦bg=#2c2d3d⟧     ⟦/⟧⟦fg=#cba6f7 bg=#2c2d3d bold⟧if⟦/⟧⟦bg=#2c2d3d⟧ d < ⟦/⟧⟦fg=#fab387 bg=#2c2d3d⟧0⟦/⟧⟦bg=#2c2d3d⟧:                                                                                      ⟦/⟧
          ⟦bg=#2c2d3d⟧         ⟦/⟧⟦fg=#cba6f7 bg=#2c2d3d bold⟧return⟦/⟧⟦bg=#2c2d3d⟧ []                                                                                  ⟦/⟧
          ⟦bg=#2c2d3d⟧     ⟦/⟧⟦fg=#cba6f7 bg=#2c2d3d bold⟧return⟦/⟧⟦bg=#2c2d3d⟧ [(-b + s * math.sqrt(d)) / (⟦/⟧⟦fg=#fab387 bg=#2c2d3d⟧2⟦/⟧⟦bg=#2c2d3d⟧ * a) ⟦/⟧⟦fg=#cba6f7 bg=#2c2d3d bold⟧for⟦/⟧⟦bg=#2c2d3d⟧ s ⟦/⟧⟦fg=#cba6f7 bg=#2c2d3d bold⟧in⟦/⟧⟦bg=#2c2d3d⟧ (⟦/⟧⟦fg=#fab387 bg=#2c2d3d⟧1⟦/⟧⟦bg=#2c2d3d⟧, -⟦/⟧⟦fg=#fab387 bg=#2c2d3d⟧1⟦/⟧⟦bg=#2c2d3d⟧)]                                    ⟦/⟧
          ⟦bg=#2c2d3d⟧                                                                                                    ⟦/⟧

